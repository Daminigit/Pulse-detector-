# ── LLM ──────────────────────────────────────────────────────────────────────

# P3 Clustering (Groq — free tier)
GROQ_API_KEY=your_groq_api_key_here
# Model: openai/gpt-oss-120b | 30 RPM, 1K RPD, 8K TPM, 200K TPD

# P4 Summarisation (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Get key: https://aistudio.google.com/app/apikey

# ── Review Ingestion ──────────────────────────────────────────────────────────
APP_ID=com.nextbillion.groww
WEEKS_BACK=10
MAX_THEMES=5

# ── Google Workspace (via MCP) ────────────────────────────────────────────────
TARGET_EMAIL=your-email@example.com
# Leave blank on first run — pipeline will create a new Doc and print the ID.
# Paste the returned ID here for all subsequent runs to update the same Doc.
GOOGLE_DOC_ID=

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
