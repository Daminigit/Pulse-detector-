# ── LLM ──────────────────────────────────────────────────────────────────────

# P3 Clustering (Groq — free tier)
GROQ_API_KEY=your_groq_api_key_here        # console.groq.com
GROQ_MODEL=openai/gpt-oss-120b             # Groq-hosted model
GROQ_TEMPERATURE=0.3                        # Low — deterministic classification
GROQ_BATCH_SIZE=15                          # Reviews per LLM call (~2.5K tokens/call)
GROQ_BATCH_SLEEP=22                         # Seconds between batches (respects 8K TPM)
# Rate limits: 30 RPM · 1K RPD · 8K TPM · 200K TPD

# P4 Summarisation (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here    # aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-3.6-flash              # Latest Gemini flash model
GEMINI_TEMPERATURE=0.7                      # Higher — creative action ideas
GEMINI_SAMPLE_PER_THEME=8                  # Reviews sampled per theme for prompt
GEMINI_MAX_WORDS=250                        # Hard word-count cap on PulseNote output

# ── Review Ingestion ──────────────────────────────────────────────────────────
APP_ID=com.nextbillion.groww
WEEKS_BACK=10
MAX_THEMES=5

# ── Google Workspace (via MCP) ────────────────────────────────────────────────
TARGET_EMAIL=your-email@example.com
# Leave blank on first run — pipeline will create a new Doc and print the ID.
# Paste the returned ID here for all subsequent runs to update the same Doc.
GOOGLE_DOC_ID=

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
